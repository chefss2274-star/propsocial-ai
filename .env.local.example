# Copy this file to `.env.local` and fill in real values.
# NEXT_PUBLIC_ vars are exposed to the browser bundle.

# --- Anthropic ---
# Server-only. Used by /api/generate to call Claude via @anthropic-ai/sdk.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Supabase ---
# Project URL + anon key are client-safe and used for auth flows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJREPLACE_ME

# Service role key bypasses RLS — server only, used by the Stripe webhook
# to write subscription rows after checkout completes.
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME_SERVICE_ROLE

# --- Stripe ---
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_REPLACE_WITH_STARTER_PRICE_ID
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_REPLACE_WITH_PRO_PRICE_ID

# Server-only secret. Keep this OUT of any NEXT_PUBLIC_ var.
# Used by /api/stripe/checkout to create Stripe Checkout Sessions.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe webhook signing secret — get it from Stripe Dashboard → Developers →
# Webhooks → your endpoint → Signing secret. Used by /api/stripe/webhook to
# verify request authenticity.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
