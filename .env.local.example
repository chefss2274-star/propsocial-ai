# Copy this file to `.env.local` and fill in real values.
# NEXT_PUBLIC_ vars are exposed to the browser bundle — only Stripe price IDs
# (which are not secrets) belong here.

NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_REPLACE_WITH_STARTER_PRICE_ID
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_REPLACE_WITH_PRO_PRICE_ID

# Server-only secret. Keep this OUT of any NEXT_PUBLIC_ var.
# Used by /api/checkout to create Stripe Checkout Sessions.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
